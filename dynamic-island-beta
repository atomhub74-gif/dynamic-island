	local function indexInOrder(name)
		for i, n in ipairs(ORDER) do
			if n == name then return i end
		end
		return 1
	end

	local function layoutDots()
		local n = #ORDER
		dotsGroup.Size = UDim2.fromOffset(16 * n, 16)
		for i, b in ipairs(dotBtns) do b.Visible = i <= n end
		updateDots()
	end

	-- bong bóng tách đôi (khai báo trước, gán ở dưới)
	local refreshBubble = function() end

	local function rebuildOrder()
		local cur = ORDER[pageIdx]
		for i = #ORDER, 1, -1 do ORDER[i] = nil end
		for _, n in ipairs(ACT_PRIORITY) do
			if act[n] then table.insert(ORDER, n) end
		end
		for _, n in ipairs(BASE_ORDER) do table.insert(ORDER, n) end
		pageIdx = indexInOrder(cur)
		layoutDots()
	end

	local function startActivity(name, hold)
		rebuildOrder()
		if not ready then return end
		if notifying then
			pendingPop = name -- sẽ mở ra sau khi thông báo hiện xong
			refreshBubble()
			return
		end
		if mode == "rest" then
			expand(indexInOrder(name), nil, hold) -- đổi trang sẽ tự cập nhật bong bóng
		else
			refreshBubble()
		end
	end

	local function endActivity(name)
		if not act[name] then return end
		local wasShowing = (current == name)
		act[name] = nil
		rebuildOrder()
		if ready and not notifying then
			if mode == "expanded" and wasShowing then
				goRest()
			elseif mode == "rest" then
				goRest() -- cập nhật dạng thu gọn
			end
		end
		refreshBubble()
	end

