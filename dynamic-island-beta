	local bsp = spring(0, 3.6, 0.55)
	local bubbleKind = nil

	refreshBubble = function()
		local want = nil
		if ready and CONFIG.ShowBubble ~= false then
			local owner = nil
			if mode ~= "notify" then
				for _, n in ipairs(ACT_PRIORITY) do
					if current == n or current == COMPACT_OF[n] then
						owner = n
						break
					end
				end
			end
			for _, n in ipairs(ACT_PRIORITY) do
				if act[n] and n ~= owner then
					want = n
					break
				end
			end
		end
		if want ~= bubbleKind then
			bubbleKind = want
			for k, ic in pairs(E.bIcons) do ic.Visible = (k == want) end
			if want then bsp.v += 5 end -- nảy nhẹ khi đổi hoạt động
		end
		bsp.t = want and 1 or 0
	end
	onPageChanged = function()
		refreshBubble()
		if ready then sensor.Visible = CONFIG.ShowSensor and not (current == "notifc" or current == "status") end
	end

