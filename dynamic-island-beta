	  DI.Status("wifi"|"dnd"|"silent"|"bluetooth"|"charging", "On")   -- thông báo nhanh icon + chữ màu
	  DI.Notify("Lữ Đình", "", {compact=true, app="Zalo", glyph="Z", iconColor=Color3.fromRGB(0,104,255)})  -- thông báo nhỏ
	  DI.Notify("Alex", "See you tonight!", {app="Telegram", glyph="T"})                                    -- thông báo đầy đủ
	  Khi có 2 hoạt động cùng lúc, đảo tách đôi: viên thuốc + bong bóng tròn (CONFIG.BubbleSide = "left" | "right")
