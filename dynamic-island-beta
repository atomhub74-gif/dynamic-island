	local function pressFx(btn)
		local sc = new("UIScale", { Scale = 1 }, btn)
		btn.MouseButton1Down:Connect(function() tw(sc, 0.1, { Scale = 0.9 }) end)
		local function up() tw(sc, 0.3, { Scale = 1 }, EZ.Back) end
		btn.MouseButton1Up:Connect(up)
		btn.MouseLeave:Connect(up)
	end

	local function circleBtn(parent, bg, glyph, size, pos)
		local b = new("TextButton", {
			Position = pos, Size = UDim2.fromOffset(size, size), BackgroundColor3 = bg, Text = glyph,
			Font = Enum.Font.GothamBold, TextSize = math.floor(size * 0.42), TextColor3 = COL.white,
			AutoButtonColor = false, BorderSizePixel = 0,
		}, parent)
		round(b)
		pressFx(b)
		return b
	end

	-- icon tạm dừng / phát vẽ bằng khối, không phụ thuộc font
	local function playIcon(parent, size)
		local bars = {}
		for i, dx in ipairs({ -size * 0.2, size * 0.2 }) do
			local f = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, dx, 0.5, 0),
				Size = UDim2.fromOffset(math.max(3, size * 0.17), size * 0.52),
				BackgroundColor3 = COL.white, BorderSizePixel = 0,
			}, parent)
			round(f, UDim.new(0, 2))
			bars[i] = f
		end
		local tri = text(parent, {
			Size = UDim2.fromScale(1, 1), Text = "▶", TextSize = math.floor(size * 0.55),
			TextXAlignment = Enum.TextXAlignment.Center, Visible = false,
		})
		return function(playing)
			bars[1].Visible, bars[2].Visible, tri.Visible = playing, playing, not playing
		end
	end

	local function makeEq(parent, pos, n, barW, gap, maxH, color)
		local f = new("Frame", {
			Position = pos, Size = UDim2.fromOffset(n * (barW + gap) - gap, maxH), BackgroundTransparency = 1,
		}, parent)
		local bars = {}
		for i = 1, n do
			local b = new("Frame", {
				AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromOffset((i - 1) * (barW + gap), maxH),
				Size = UDim2.fromOffset(barW, 3), BackgroundColor3 = color, BorderSizePixel = 0,
			}, f)
			round(b)
			bars[i] = b
		end
		return { bars = bars, barW = barW, maxH = maxH }
	end

	local function animateEq(eq, playing, t)
		for i, b in ipairs(eq.bars) do
			local h = 3
			if playing then
				h = 3 + (eq.maxH - 3) * (0.5 + 0.5 * math.sin(t * 6 + i * 1.9) * math.sin(t * 2.3 + i))
			end
			b.Size = UDim2.fromOffset(eq.barW, h)
		end
	end

	local function fmtClock(sec)
		sec = math.max(0, math.ceil(sec))
		local h, m, s = math.floor(sec / 3600), math.floor((sec % 3600) / 60), sec % 60
		if h > 0 then return string.format("%d:%02d:%02d", h, m, s) end
		return string.format("%02d:%02d", m, s)
	end

	local function initials(name)
		local words = {}
		for w in name:gmatch("%S+") do table.insert(words, w) end
		if #words == 0 then return "?" end
		local function first(w)
			local ok, ch = pcall(function() return utf8.char(utf8.codepoint(w, 1)) end)
			return ok and ch or w:sub(1, 1)
		end
		local s = first(words[1])
		if #words > 1 then s ..= first(words[#words]) end
		return s:upper()
	end

	-- ── Icon vẽ bằng khối (đơn sắc, nét tròn như icon trong video) ──
	local function seg(parent, x1, y1, x2, y2, th, color)
		local dx, dy = x2 - x1, y2 - y1
		local f = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
			Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + th * 0.5, th),
			Rotation = math.deg(math.atan2(dy, dx)), BackgroundColor3 = color, BorderSizePixel = 0,
		}, parent)
		round(f)
		return f
	end

	local function dotAt(parent, x, y, d, color)
		local f = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(d, d), BackgroundColor3 = color, BorderSizePixel = 0,
		}, parent)
		round(f)
		return f
	end

	local function makeIcon(kind, parent, color, S, x, y, glyph)
		local c = new("CanvasGroup", {
			Position = UDim2.fromOffset(x or 0, y or 0), Size = UDim2.fromOffset(S, S),
			BackgroundTransparency = 1, BorderSizePixel = 0,
		}, parent)
		local th = math.max(2, S * 0.11)
		if kind == "bolt" then
			local t2 = math.max(2.5, S * 0.17)
			seg(c, S * 0.62, S * 0.10, S * 0.30, S * 0.56, t2, color)
			seg(c, S * 0.30, S * 0.56, S * 0.70, S * 0.46, t2, color)
			seg(c, S * 0.70, S * 0.46, S * 0.38, S * 0.92, t2, color)
		elseif kind == "phone" then
			local cx, cy, r = S * 0.30, S * 0.70, S * 0.38
			for a = -90, 0, 10 do
				local rad = math.rad(a)
				dotAt(c, cx + r * math.cos(rad), cy + r * math.sin(rad), S * 0.24, color)
			end
			seg(c, S * 0.14, S * 0.32, S * 0.44, S * 0.32, S * 0.2, color)
			seg(c, S * 0.68, S * 0.56, S * 0.68, S * 0.86, S * 0.2, color)
		elseif kind == "stopwatch" then
			local ring = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(S * 0.5, S * 0.58),
				Size = UDim2.fromOffset(S * 0.78, S * 0.78), BackgroundTransparency = 1, BorderSizePixel = 0,
			}, c)
			round(ring)
			new("UIStroke", { Color = color, Thickness = th, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, ring)
			seg(c, S * 0.5, S * 0.07, S * 0.5, S * 0.15, th * 1.2, color)
			seg(c, S * 0.5, S * 0.58, S * 0.66, S * 0.42, th * 0.9, color)
		elseif kind == "recbox" then
			local box = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(S * 0.5, S * 0.5),
				Size = UDim2.fromOffset(S * 0.84, S * 0.84), BackgroundTransparency = 1, BorderSizePixel = 0,
			}, c)
			round(box, UDim.new(0, math.floor(S * 0.22)))
			new("UIStroke", { Color = color, Thickness = th, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, box)
			dotAt(c, S * 0.5, S * 0.5, S * 0.34, color)
		elseif kind == "moon" then
			dotAt(c, S * 0.46, S * 0.5, S * 0.74, color)
			dotAt(c, S * 0.68, S * 0.36, S * 0.62, Color3.new(0, 0, 0))
		elseif kind == "wifi" then
			for _, rr in ipairs({ 0.24, 0.44, 0.64 }) do
				for a = -135, -45, 15 do
					local rad = math.rad(a)
					dotAt(c, S * 0.5 + S * rr * math.cos(rad), S * 0.84 + S * rr * math.sin(rad), th * 1.05, color)
				end
			end
			dotAt(c, S * 0.5, S * 0.84, th * 1.7, color)
		elseif kind == "badge" then
			local b = dotAt(c, S * 0.5, S * 0.5, S * 0.96, color)
			text(b, {
				Size = UDim2.fromScale(1, 1), Text = glyph or "?", TextSize = math.floor(S * 0.6),
				TextXAlignment = Enum.TextXAlignment.Center,
			})
		else
			text(c, {
				Size = UDim2.fromScale(1, 1), Text = glyph or "?", TextSize = math.floor(S * 0.9),
				TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Center,
			})
		end
		return c
	end

