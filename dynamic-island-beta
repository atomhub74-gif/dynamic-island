local startTick = tick()
local pages = { compact = pCompact, stats = pStats, player = pPlayer, clock = pClock, notify = pNotify }
local current = nil           -- trang đang hiện (nil = idle)
local mode = "rest"           -- "rest" | "expanded" | "notify"
local pageIdx = 1
local token = 0
local dotsShown = false
local ready = false      -- false trong lúc màn load
local capRadius = 26     -- bo góc tối đa (26 khi còn là hình vuông, 44 sau khi load)
local act = {}               -- hoạt động đang chạy: call / timer / music
local ACT_PRIORITY = { "call", "record", "timer", "music", "charge" }
local COMPACT_OF = { call = "ccall", record = "crec", timer = "ctimer", music = "cmusic", charge = "ccharge" }
local BASE_ORDER = { "stats", "player", "clock" }
local EXTRA_ENTER = {}           -- hoạt ảnh phụ khi vào trang (hoạt động đăng ký thêm)
local pendingPop = nil
local lastTouch = tick()     -- lần cuối người chơi chạm vào đảo (để tự thu gọn khi không thao tác)
local OPEN_PAGES = { stats = true, player = true, clock = true, notify = true, music = true, call = true, timer = true }
local DOT_PAGES = { stats = true, player = true, clock = true, music = true, call = true, timer = true }
local NOTIFY_STYLES = {}         -- các kiểu thông báo: notify / compact / status
local onPageChanged              -- gọi mỗi khi đổi trang (bong bóng tách đôi dùng)
local bubbleUpdate
local updateActivities
local function homeIdx() return next(act) ~= nil and 1 or pageIdx end
local function indexOfPage(name)
	for i, n in ipairs(ORDER) do
		if n == name then return i end
	end
	return nil
end

-- Hai lò xo (rộng & cao) với độ cứng hơi khác nhau → chuyển động "có hồn" hơn
local sw = spring(24, 3.4, 0.6)
local sh = spring(24, 3.4, 0.6)

local function applyLang()
	local L = T()
	V.tFps.lab.Text, V.tPing.lab.Text, V.tMem.lab.Text = L.fps, L.ping, L.mem
	V.clSesLab.Text, V.pCountLab.Text = L.session, L.players
