		if not ready or not bubbleKind then return end
		if notifying then skip = true return end
		expand(indexInOrder(bubbleKind))
	end)

	bubbleUpdate = function(dt)
		step(bsp, math.min(dt, 1 / 20))
		local p = bsp.p
		if p < 0.01 and bsp.t == 0 then
			if E.bubble.Visible then E.bubble.Visible = false end
			return
		end
		E.bubble.Visible = true
		local ps = math.clamp(p, 0, 1.25)
		local sc = uiscale.Scale
		local w = math.max(sw.p, 28) * sc               -- bề rộng thật của đảo ngay khung hình này (không trễ)
		local cx = gui.AbsoluteSize.X / 2               -- đảo luôn nằm giữa màn hình
		local cy = root.AbsolutePosition.Y + 18.5 * sc
		local side = (CONFIG.BubbleSide == "right") and 1 or -1
		local dist = (w / 2 + 8 * sc + 20 * sc) * ps
		E.bubble.Position = UDim2.fromOffset(cx + side * dist, cy)
		E.bubbleScale.Scale = sc * math.max(ps, 0.01)
	end

	-- ── CẬP NHẬT MỖI KHUNG HÌNH ─────────────────────────────────
	local lastStr = setmetatable({}, { __mode = "k" })
	local function setText(lbl, str)
		if lastStr[lbl] ~= str then
			lastStr[lbl] = str
			lbl.Text = str
		end
	end

	updateActivities = function()
		if next(act) == nil then return end
		local now = tick()

		local m = act.music
		if m then
			if m.playing then m.elapsed += now - m.lastT end
			m.lastT = now
			if m.duration and m.elapsed >= m.duration then m.elapsed = 0 end -- hết bài: phát lại
			setText(E.mElapsed, fmtDur(m.elapsed))
			if m.duration then
				setText(E.mRemain, "-" .. fmtDur(m.duration - m.elapsed))
				E.mFill.Size = UDim2.fromScale(math.clamp(m.elapsed / m.duration, 0, 1), 1)
			else
				setText(E.mRemain, "")
				E.mFill.Size = UDim2.fromScale(0, 1)
			end
			if current == "music" then
				animateEq(E.mEq, m.playing, now)
			elseif current == "cmusic" then
				animateEq(E.cmEq, m.playing, now)
			end
		end

		local tm = act.timer
		if tm then
			if tm.running then tm.remaining = math.max(0, tm.endT - now) end
			local str = fmtClock(tm.remaining)
			setText(E.tmTime, str)
			setText(E.ctRight, str)
			E.tmFill.Size = UDim2.fromScale(math.clamp(tm.remaining / tm.total, 0, 1), 1)
			if tm.running and tm.remaining <= 0 then
				local label = tm.label
				endActivity("timer")
				DI.Status("timer", T().timerDone, { color = COL.orange, duration = 3.5 })
			end
		end

		local c = act.call
		if c then
			if c.state == "incall" then
				local str = fmtDur(now - c.t0)
				setText(E.cSub, str)
				setText(E.ccText, str)
				E.ccIcon.GroupTransparency = 0
				if current == "ccall" then animateEq(E.ccBars, true, now * 1.6) end
			else
				setText(E.cSub, T().incoming)
				setText(E.ccText, T().ringShort)
				E.ccIcon.GroupTransparency = 0.5 * (0.5 + 0.5 * math.sin(now * 7))
				if current == "ccall" then animateEq(E.ccBars, false, now) end
			end
		end

		local r = act.record
		if r then
			local str = fmtClock(math.floor(now - r.t0))
			setText(E.rTime, str)
			setText(E.crRight, str)
			local pulse = 0.55 * (0.5 + 0.5 * math.sin(now * 5))
			E.crDot.BackgroundTransparency = pulse
			E.rDot.BackgroundTransparency = pulse
		end

		local ch = act.charge
		if ch then
			local str = math.floor(ch.pct + 0.5) .. "%"
			setText(E.chRight, str)
			setText(E.cgPct, str)
			E.cgFill.Size = UDim2.fromScale(math.clamp(ch.pct / 100, 0, 1), 1)
		end
	end

	layoutDots()
end



