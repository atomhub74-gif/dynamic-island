local DI = { Config = CONFIG }

local function firstChar(str)
	local ok, ch = pcall(function() return utf8.char(utf8.codepoint(str, 1)) end)
	return string.upper(ok and ch or str:sub(1, 1))
end

function DI.Notify(title, body, opts)
	opts = opts or {}
	local k = KINDS[opts.kind or "info"] or KINDS.info
	local style = opts.style or (opts.compact and "compact") or "notify"
	table.insert(queue, {
		title = tostring(title or ""), text = tostring(body or ""),
		color = opts.color or k[1], iconColor = opts.iconColor,
		glyph = opts.glyph or (opts.app and firstChar(opts.app)) or k[2],
		duration = opts.duration or (style == "compact" and 3 or 3.5), userId = opts.userId,
		app = opts.app, timeLabel = opts.timeLabel, style = style,
	})
	runQueue()
end

function DI.Expand(i) if not notifying then expand(i or pageIdx) end end
function DI.Collapse() if not notifying then goRest() end end
