local function switchRow(key, initial, onChange)
	local r = row(44)
	local lab = text(r, { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -80, 1, 0), TextSize = 14, Font = Enum.Font.GothamMedium })
	bind(function() lab.Text = T()[key] end)
	local track = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(50, 30),
		BackgroundColor3 = COL.track, Text = "", AutoButtonColor = false, BorderSizePixel = 0,
	}, r)
	round(track)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(24, 24),
		BackgroundColor3 = COL.white, BorderSizePixel = 0,
	}, track)
	round(knob)
	local state = initial
	local function set(on, instant)
		state = on
		local pos = on and UDim2.new(0, 23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
		local col = on and COL.green or COL.track
		if instant then
			knob.Position, track.BackgroundColor3 = pos, col
		else
			tw(knob, 0.4, { Position = pos }, EZ.Back)
			tw(track, 0.25, { BackgroundColor3 = col })
		end
	end
	set(initial, true)
	track.Activated:Connect(function()
		set(not state)
		if onChange then onChange(state) end
	end)
	return set
end

