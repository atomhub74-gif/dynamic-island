local KINDS = {
	info    = { COL.blue,   "i" },
	success = { COL.green,  "✓" },
	warn    = { COL.orange, "!" },
	error   = { COL.red,    "✕" },
}
local queue, notifying, skip, notifyId = {}, false, false, 0
local barTween -- tween thanh đếm ngược của thông báo đang hiện
local function cancelBar()
	if barTween then barTween:Cancel(); barTween = nil end
end

local function glow(color)
	-- viền sáng trên đảo
	stroke.Color, stroke.Transparency, stroke.Thickness = color, 0.15, 2
	tw(stroke, 1.2, { Transparency = 0.9, Thickness = 1, Color = COL.white }, EZ.Quad)
	-- vòng sóng toả ra theo màu thông báo
	ringStroke.Color, ringStroke.Transparency, ringStroke.Thickness = color, 0.25, 3
	ring.Size = UDim2.new(1, 4, 1, 4)
	tw(ring, 1.0, { Size = UDim2.new(1, 46, 1, 46) }, EZ.Quint)
	tw(ringStroke, 1.0, { Transparency = 1, Thickness = 1 }, EZ.Quad)
	-- "giật" nhẹ khi có thông báo
	sw.v += 70; sh.v += 25
end

-- Kiểu thông báo mặc định: "notify" (đầy đủ, giống Telegram trong video)
NOTIFY_STYLES.notify = {
	page = "notify", bar = true,
	fill = function(n, id)
		local hasApp = n.app ~= nil and n.app ~= ""
		V.nHead.Visible = hasApp
		V.nHead.Text = hasApp and (n.app .. " · " .. (n.timeLabel or T().justNow)) or ""
		V.nTitle.Position = UDim2.fromOffset(76, hasApp and 46 or 34)
		V.nBody.Position = UDim2.fromOffset(76, hasApp and 65 or 56)
		basePos[V.nTitle], basePos[V.nBody] = nil, nil
		V.nBody.TextColor3 = hasApp and Color3.fromRGB(220, 220, 226) or COL.gray
		V.nTitle.Text, V.nBody.Text = n.title, n.text
		V.nIcon.BackgroundColor3 = n.iconColor or n.color
		V.nGlyph.Text, V.nGlyph.Visible, V.nImg.Visible = n.glyph, true, false
		if n.userId then
			task.spawn(function()
				local ok, img = pcall(function()
					return Players:GetUserThumbnailAsync(n.userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
				end)
				if ok and img and id == notifyId then
					V.nImg.Image, V.nImg.Visible, V.nGlyph.Visible = img, true, false
				end
			end)
		end
	end,
}

local function showNotify(n)
	notifyId += 1
	local id = notifyId
	local st = NOTIFY_STYLES[n.style or "notify"] or NOTIFY_STYLES.notify
	st.fill(n, id)
	-- đặt lại thời gian: huỷ thanh đếm của thông báo cũ, thanh mới đầy lại từ đầu
	cancelBar()
	if st.bar then
		V.nBar.BackgroundColor3 = n.color
		V.nBar.Size = UDim2.fromScale(1, 1)
	end
	setPage(st.page)
	glow(n.color)
	if st.bar then
		task.delay(0.35, function()
			if alive and id == notifyId then
				barTween = tw(V.nBar, math.max(n.duration - 0.35, 0.1), { Size = UDim2.fromScale(0, 1) }, EZ.Linear)
			end
		end)
	end
end

local function runQueue()
	if notifying then return end
	notifying = true
	local resumeName = (mode == "expanded") and ORDER[pageIdx] or nil -- đang mở thì mở lại sau khi xong
	task.spawn(function()
		while alive and not ready do task.wait(0.1) end -- chờ màn load xong
		while alive and #queue > 0 do
			-- luôn lấy thông báo MỚI NHẤT, bỏ những cái cũ chưa kịp hiện
			local n = queue[#queue]
			queue = {}
			mode = "notify"
			token += 1
			if isOpenPage(current) then
				-- đang mở (trang khác hoặc thông báo trước): đóng lại rồi mới mở thông báo mới
				cancelBar()
				setPage(restPage())
				task.wait(CLOSE_WAIT)
				if not alive then break end
				if #queue > 0 then n = queue[#queue]; queue = {} end -- có cái mới hơn lúc đang đóng
			end
			showNotify(n)
			skip = false
			local t0 = tick()
			-- có thông báo mới tới là chuyển sang ngay (không đợi hết giờ cái đang hiện)
			while alive and not skip and #queue == 0 and tick() - t0 < n.duration do task.wait(0.05) end
		end
		notifying = false
		if alive then
			local popName = pendingPop
			pendingPop = nil
			if popName and act[popName] and indexOfPage(popName) then
				expand(indexOfPage(popName))
			elseif resumeName and indexOfPage(resumeName) then
				expand(indexOfPage(resumeName))
			else
				goRest()
			end
		end
	end)
end

