-- Hoạt ảnh phụ khi vào trang
local basePos = setmetatable({}, { __mode = "k" })
local function slideIn(obj, delay, dx, dy)
	local base = basePos[obj]
	if not base then base = obj.Position; basePos[obj] = base end
	local prop = obj:IsA("TextLabel") and "TextTransparency" or "GroupTransparency"
	obj.Position = base + UDim2.fromOffset(dx or 0, dy or 0)
	obj[prop] = 1
	task.delay(delay, function()
		if alive then tw(obj, 0.55, { Position = base, [prop] = 0 }) end
	end)
end

local function pop(scaleObj, delay)
	scaleObj.Scale = 0.2
	task.delay(delay, function()
		if alive then tw(scaleObj, 0.65, { Scale = 1 }, EZ.Back) end
	end)
end

local function enterExtras(name)
	local ex = EXTRA_ENTER[name]
	if ex then
		ex()
		return
	end
	if name == "stats" then
		slideIn(V.tFps.group, 0, 0, 20); slideIn(V.tPing.group, 0.06, 0, 20); slideIn(V.tMem.group, 0.12, 0, 20)
	elseif name == "player" then
		pop(V.avScale, 0)
		slideIn(V.pName, 0.08, 18, 0); slideIn(V.pUser, 0.13, 18, 0); slideIn(V.pAge, 0.18, 18, 0)
		slideIn(V.pCount, 0.10, -18, 0); slideIn(V.pCountLab, 0.15, -18, 0)
	elseif name == "clock" then
		slideIn(V.clTime, 0, 0, 14); slideIn(V.clDate, 0.1, 14, 0)
		slideIn(V.clSesLab, 0.06, -18, 0); slideIn(V.clSes, 0.1, -18, 0)
	elseif name == "notify" then
		pop(V.nIconScale, 0)
		slideIn(V.nHead, 0.04, 20, 0); slideIn(V.nTitle, 0.08, 20, 0); slideIn(V.nBody, 0.14, 20, 0)
	end
end

local function updateDots()
	for i, d in ipairs(dots) do
		local on = (i == pageIdx)
		tw(d, 0.4, {
			BackgroundColor3 = on and COL.white or COL.dim,
			Size = on and UDim2.fromOffset(14, 6) or UDim2.fromOffset(6, 6),
		}, EZ.Back)
	end
end

-- Chuyển trang + đổi kích thước đảo. dir = 1 / -1 để trượt ngang, nil = không trượt
local function rawSetPage(name, dir)
	current = name

	for n, p in pairs(pages) do
		if n ~= name and p.Visible then
			local out = dir and UDim2.new(0.5, -dir * 42, 0.5, 0) or UDim2.fromScale(0.5, 0.5)
			tw(p, 0.16, { GroupTransparency = 1, Position = out }, EZ.Quad)
			tw(p.S, 0.16, { Scale = 0.9 }, EZ.Quad)
			task.delay(0.18, function()
				if current ~= n then p.Visible = false end
			end)
		end
	end

	-- đảo nở ra → lò xo mềm, nảy nhiều; thu lại → cứng hơn, ít nảy
	local dim = LAYOUT[name or "idle"]
	local expanding = dim[1] * dim[2] > sw.t * sh.t
	local f, d = expanding and 3.3 or 4.2, expanding and 0.56 or 0.8
	sw.f, sw.d, sh.f, sh.d = f * 1.08, d, f * 0.94, d
	sw.t, sh.t = dim[1], dim[2]

	if name then
		local p = pages[name]
		p.Visible = true
		p.GroupTransparency = 1
		p.S.Scale = 0.86
		p.Position = UDim2.new(0.5, (dir or 0) * 42, 0.5, 0)
		task.delay(0.09, function()
			if alive and current == name then
				tw(p, 0.4, { GroupTransparency = 0, Position = UDim2.fromScale(0.5, 0.5) })
				tw(p.S, 0.6, { Scale = 1 }, EZ.Back)
				enterExtras(name)
			end
		end)
	end

	local showDots = CONFIG.ShowPageDots and DOT_PAGES[name] == true
	dotsShown = showDots
	if showDots then
		dotsGroup.Visible = true
		tw(dotsGroup, 0.35, { GroupTransparency = 0 })
	else
		tw(dotsGroup, 0.15, { GroupTransparency = 1 })
		task.delay(0.2, function() if not dotsShown then dotsGroup.Visible = false end end)
	end
	if onPageChanged then onPageChanged() end
end

-- ── CHUYỂN TRẠNG THÁI: đóng đảo lại rồi mới mở ra lại ──────────
-- (không đổi nội dung ngay khi đang mở; mọi lần chuyển trang / thông báo đều đi qua đây)
local CLOSE_WAIT = 0.45 -- chờ đảo thu xong rồi mới mở
local transToken = 0
local function restPage()
	for _, n in ipairs(ACT_PRIORITY) do
		if act[n] then return COMPACT_OF[n] end -- đang có cuộc gọi / hẹn giờ / nhạc → dạng thu gọn của nó
	end
	return CONFIG.RestMode == "compact" and "compact" or nil
end
local function isOpenPage(n) return OPEN_PAGES[n] == true end

local function setPage(name, dir) -- gọi trực tiếp: huỷ mọi lần "mở lại" đang chờ
	transToken += 1
	rawSetPage(name, dir)
end

local function reopenWith(name) -- đóng lại → chờ → mở trang mới
	transToken += 1
	local my = transToken
	rawSetPage(restPage())
	task.delay(CLOSE_WAIT, function()
		if alive and transToken == my then rawSetPage(name) end
	end)
end

local function goRest()
	mode = "rest"
	token += 1
	setPage(CONFIG.RestMode == "compact" and "compact" or nil)
end

local function expand(idx, dir, hold)
	if not ready then return end
	local newIdx = ((idx - 1) % #ORDER) + 1
	if mode == "expanded" and current == ORDER[newIdx] then return end
	mode = "expanded"
	lastTouch = tick()
	pageIdx = newIdx
	token += 1
	local my = token
	if isOpenPage(current) then
		reopenWith(ORDER[pageIdx]) -- đang mở trang/thông báo khác: đóng lại rồi mở
	else
		setPage(ORDER[pageIdx], dir)
	end
	updateDots()
	local holdFor = hold -- chỉ dùng cho hoạt động tự bật (nhạc / hẹn giờ...), còn lại tính theo thời gian không thao tác
	if holdFor and holdFor > 0 then
		task.delay(holdFor, function()
			if alive and token == my and mode == "expanded" then goRest() end
		end)
	end
end

selectDot = function(i)
	if mode == "expanded" and i ~= pageIdx then expand(i, i > pageIdx and 1 or -1) end
end

-- Cập nhật số liệu (mỗi 0.5s)
local fps = 60
local function refresh()
	local f = math.floor(fps + 0.5)
	local ping = getPing()
	local mem = math.floor(Stats:GetTotalMemoryUsageMb() + 0.5)
	local fc, pc = fpsColor(f), pingColor(ping)

	V.cFps.Text, V.cDot.BackgroundColor3 = tostring(f), fc
	V.cPing.Text, V.cPing.TextColor3 = ping .. "ms", pc

	V.tFps.val.Text, V.tPing.val.Text, V.tMem.val.Text = tostring(f), ping .. "ms", mem .. "MB"
	V.tFps.fill.BackgroundColor3, V.tPing.fill.BackgroundColor3 = fc, pc
	tw(V.tFps.fill, 0.5, { Size = UDim2.fromScale(math.clamp(f / 60, 0.04, 1), 1) })
	tw(V.tPing.fill, 0.5, { Size = UDim2.fromScale(math.clamp(1 - ping / 300, 0.04, 1), 1) })
	tw(V.tMem.fill, 0.5, { Size = UDim2.fromScale(math.clamp(mem / 3000, 0.04, 1), 1) })

	V.pCount.Text = #Players:GetPlayers() .. "/" .. Players.MaxPlayers

	local d = os.date("*t")
	V.clTime.Text = os.date("%H:%M")
	V.clDate.Text = T().wd[d.wday] .. ", " .. os.date("%d/%m/%Y")
	V.clSes.Text = fmtDur(tick() - startTick)
end

-- Vòng lặp chính
local acc, frames, settledApplied = 0, 0, false
table.insert(conns, RunService.Heartbeat:Connect(function(rawDt)
	local dt = math.min(rawDt, 1 / 20)
	local moving = math.abs(sw.p - sw.t) > 0.05 or math.abs(sw.v) > 0.05
		or math.abs(sh.p - sh.t) > 0.05 or math.abs(sh.v) > 0.05
	if moving then
		step(sw, dt); step(sh, dt)
		settledApplied = false
	elseif not settledApplied then
		sw.p, sw.v, sh.p, sh.v = sw.t, 0, sh.t, 0
		settledApplied = true
		moving = true
	end
	if moving then
		local w, h = math.max(sw.p, 28), math.max(sh.p, 20)
		root.Size = UDim2.fromOffset(w, h)
		corner.CornerRadius = UDim.new(0, math.min(h / 2, capRadius))
		ringCorner.CornerRadius = UDim.new(0, math.min(h / 2, capRadius) + 23)
	end

	-- chấm FPS "thở" nhẹ
	if current == "compact" then
		V.cDot.BackgroundTransparency = 0.35 * (0.5 + 0.5 * math.sin(tick() * 4))
	end

	if updateActivities then updateActivities() end
	if bubbleUpdate then bubbleUpdate(rawDt) end

	-- đang mở mà người chơi không thao tác quá AutoCollapse giây → tự thu gọn (cuộc gọi đang đổ chuông thì giữ nguyên)
	if mode == "expanded" and ready and not notifying and CONFIG.AutoCollapse and CONFIG.AutoCollapse > 0 then
		local ringing = (current == "call") and act.call ~= nil and act.call.state == "ringing"
		if not ringing and tick() - lastTouch > CONFIG.AutoCollapse then goRest() end
	end

	acc += rawDt
	frames += 1
	if acc >= 0.5 then
		fps = frames / acc
		acc, frames = 0, 0
		refresh()
	end
end))

